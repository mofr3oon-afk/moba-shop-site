# EXAMPLE ONLY. Generate unique secrets; never commit actual values.
# Railway, separate new service (do not deploy before owner approval):
TOPUP_DB_PATH=/data/topup.sqlite
TOPUP_ADMIN_IDS=YOUR_TELEGRAM_USER_ID
BOT_TOKEN=SET_IN_RAILWAY_ENVIRONMENT
STOCK_ACTIVE_KEY_ID=v1
STOCK_KEYS_JSON={"v1":"BASE64_ENCODED_RANDOM_32_BYTE_KEY"}
STOCK_FINGERPRINT_KEY=UNIQUE_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
BACKUP_KEY_BASE64=ANOTHER_BASE64_ENCODED_RANDOM_32_BYTE_KEY
BACKUP_DIRECTORY=/data/backups
TOPUP_BRIDGE_SECRET=UNIQUE_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
SMS_WEBHOOK_SECRET=A_DIFFERENT_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
ALLOW_MANUAL_VERIFIED_PAYMENTS=false
ALLOW_REAL_STOCK_IMPORT=false
VODAFONE_RECEIVER_WALLET=
# Existing Vercel project, only after a tested service is provisioned:
TOPUP_ENABLED=false
TOPUP_SERVICE_URL=https://YOUR_SERVICE.up.railway.app
# TOPUP_BRIDGE_SECRET must match the Railway value.
